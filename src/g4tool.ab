// The ANTLR 4.9 tool's front end on grammar ASTs: imports, the implicit lexer
// of a combined grammar, block-to-set reduction, the left-recursion rewrite,
// rule and token numbering. g4atn.ab builds the ATN from the result.

import "abla/text"
import "intervalset.ab"
import "lexer.ab"
import "g4lexer.ab"
import "g4ast.ab"
import "g4parser.ab"
import "g4chars.ab"

val defaultModeName = "DEFAULT_MODE"

fun isTokenName(name: string): bool {
    if (name.size == 0) return false
    val b = name[0]
    if (b < 128) return b >= 65 && b <= 90
    isUpperStart(codePointAtUnits(g4Units(name), 0))
}

fun javaTrim(s: string): string {
    var a = 0
    var b = s.size
    while (a < b && s[a] <= 32) a += 1
    while (b > a && s[b - 1] <= 32) b -= 1
    s.slice(a, b)
}

class G4Grammar(
    val name: string,
    val kind: int,
    var root: int,
    val sr: int,
    var parent: int,
    var imports: array<int>,
    var tokenNames: Map<string, int>,
    var literals: Map<string, int>,
    var typeToLiteral: array<string?>,
    var typeToToken: array<string?>,
    var maxTokenType: int,
    var channels: Map<string, int>,
    var channelToName: array<string?>,
    var maxChannel: int,
    var ruleNames: array<string>,
    var ruleAst: array<int>,
    var ruleMode: array<string>,
    var ruleFragment: array<bool>,
    var ruleLr: array<bool>,
    var ruleIndex: Map<string, int>,
    var modeNames: array<string>,
    var modeRules: array<array<int>>,
    var litRuleNumber: int,
    var sempreds: array<int>,
    var lexerActions: array<int>
) {
    fun isLexer(): bool = kind == gkLexer

    fun getTokenType(t: string): int {
        val v = if (t.size > 0 && t[0] == 39) literals.get(t) else tokenNames.get(t)
        if (v == null) 0 else v
    }

    fun maxType(): int = typeToToken.size - 1

    fun newTokenType(): int {
        maxTokenType += 1
        maxTokenType
    }

    fun setTokenForType(ttype: int, txt: string): void {
        if (ttype == -1) return
        while (typeToToken.size <= ttype) typeToToken.append(null)
        val prev = typeToToken[ttype]
        if (prev == null) typeToToken[ttype] = txt
        else if (prev.size > 0 && prev[0] == 39) typeToToken[ttype] = txt
    }

    fun defineTokenNameType(n: string, ttype: int): int {
        val prev = tokenNames.get(n)
        if (prev != null) return prev
        tokenNames.set(n, ttype)
        setTokenForType(ttype, n)
        if (ttype > maxTokenType) maxTokenType = ttype
        ttype
    }

    fun defineTokenName(n: string): int {
        val prev = tokenNames.get(n)
        if (prev != null) return prev
        defineTokenNameType(n, newTokenType())
    }

    fun defineStringLiteralType(lit: string, ttype: int): int {
        if (literals.has(lit)) return 0
        literals.set(lit, ttype)
        while (typeToLiteral.size <= ttype) typeToLiteral.append(null)
        typeToLiteral[ttype] = lit
        setTokenForType(ttype, lit)
        ttype
    }

    fun defineTokenAlias(n: string, lit: string): int {
        val ttype = defineTokenName(n)
        literals.set(lit, ttype)
        setTokenForType(ttype, n)
        ttype
    }

    fun setChannelNameForValue(value: int, n: string): void {
        while (channelToName.size <= value) channelToName.append(null)
        if (channelToName[value] == null) channelToName[value] = n
    }

    fun defineChannelNameValue(n: string, value: int): int {
        val prev = channels.get(n)
        if (prev != null) return prev
        channels.set(n, value)
        setChannelNameForValue(value, n)
        if (value > maxChannel) maxChannel = value
        value
    }

    fun defineChannelName(n: string): int {
        val prev = channels.get(n)
        if (prev != null) return prev
        maxChannel += 1
        defineChannelNameValue(n, maxChannel)
    }

    fun channelValue(n: string): int {
        val v = channels.get(n)
        if (v == null) -1 else v
    }

    fun ruleOf(n: string): int {
        val v = ruleIndex.get(n)
        if (v == null) -1 else v
    }

    fun modeIndex(n: string): int {
        var at = -1
        for (i in 0 until modeNames.size) if (at < 0 && modeNames[i] == n) at = i
        at
    }

    fun literalNames(): array<string?> {
        val n = maxType() + 1
        val names: array<string?> = []
        for (i in 0 until n) names.append(if (i < typeToLiteral.size) typeToLiteral[i] else null)
        for (k in literals.keys()) {
            val v = literals.get(k)
            if (v != null && v >= 0 && v < n && names[v] == null) names[v] = k
        }
        names
    }

    fun symbolicNames(): array<string?> {
        val n = maxType() + 1
        val names: array<string?> = []
        for (i in 0 until n) {
            var s: string? = null
            if (i < typeToToken.size) {
                val t = typeToToken[i]
                if (t != null && !t.startsWith("T__")) s = t
            }
            names.append(s)
        }
        names
    }

    // The .tokens file the tool writes for this grammar.
    fun vocabText(): string {
        var s = ""
        for (k in tokenNames.keys()) {
            val v = tokenNames.get(k)
            if (v != null && v >= 1) s = s + "$k=$v\n"
        }
        for (k in literals.keys()) {
            val v = literals.get(k)
            if (v != null && v >= 1) s = s + "$k=$v\n"
        }
        s
    }
}

fun g4Grammar(name: string, kind: int, root: int, sr: int): G4Grammar {
    val tokenNames: Map<string, int> = Map()
    tokenNames.set("EOF", -1)
    val typeToToken: array<string?> = [null]
    G4Grammar(name, kind, root, sr, -1, [], tokenNames, Map(), [], typeToToken, 0, Map(), [], 1,
        [], [], [], [], [], Map(), [], [], 0, [], [])
}

class G4Tool(
    var ast: G4Ast,
    var grammars: array<G4Grammar>,
    var sources: Map<string, string>,
    var loaded: Map<string, int>,
    var error: string,
    var curRule: string
)

fun g4Tool(sources: Map<string, string>): G4Tool {
    val src: Map<string, string> = Map()
    for (k in sources.keys()) {
        val v = sources.get(k)
        if (v != null) src.set(k, v)
    }
    G4Tool(g4Ast(), [], src, Map(), "", "")
}

fun G4Tool.fail(message: string): void {
    if (error.size == 0) error = message
}

// Parses grammar text; returns the new grammar's index or -1.
fun G4Tool.parseGrammar(text: string, fileName: string): int {
    val sr = ast.addStream(g4Lex(sourceText(text)))
    val errs: array<string> = []
    val root = g4Parse(ast, sr, errs)
    if (root < 0) {
        fail("$fileName: ${errs[0]}")
        return -1
    }
    val name = ast.text[ast.child(root, 0)]
    grammars.append(g4Grammar(name, ast.grammarKind(root), root, sr))
    grammars.size - 1
}

fun G4Tool.loadImported(gi: int): void {
    val root = grammars[gi].root
    val imp = ast.firstChildWithType(root, gtImport)
    if (imp < 0) return
    val me = grammars[gi].name
    for (c in copyKids(ast.kids[imp])) {
        val t = if (ast.type[c] == gtAssign) ast.child(c, 1) else c
        val name = ast.text[t]
        if (name != me) {
            var g = -1
            val cached = loaded.get(name)
            if (cached != null) g = cached
            else {
                val t1 = sources.get(name + ".g4")
                val t2 = sources.get(name + ".g")
                if (t1 != null) g = parseGrammar(t1, name + ".g4")
                else if (t2 != null) g = parseGrammar(t2, name + ".g")
                else fail("can't find or load grammar $name")
                if (g >= 0) loaded.set(grammars[g].name, g)
            }
            if (g >= 0) {
                grammars[g].parent = gi
                grammars[gi].imports.append(g)
                loadImported(g)
            }
        }
    }
}

fun G4Tool.allImported(gi: int, var out: array<int>): void {
    for (d in copyInts(grammars[gi].imports)) {
        var seen = false
        for (o in out) if (o == d) seen = true
        if (!seen) out.append(d)
        allImported(d, out)
    }
}

fun G4Tool.grammarOfStream(sr: int): int {
    var g = -1
    for (i in 0 until grammars.size) if (g < 0 && grammars[i].sr == sr) g = i
    g
}

fun G4Tool.childrenWithType(n: int, ty: int): array<int> {
    val r: array<int> = []
    for (c in ast.kids[n]) if (ast.type[c] == ty) r.append(c)
    r
}

// GrammarTransformPipeline.integrateImportedGrammars
fun G4Tool.integrateImports(gi: int): void {
    val imports: array<int> = []
    allImported(gi, imports)
    if (imports.size == 0) return
    val root = grammars[gi].root
    var channelsRoot = ast.firstChildWithType(root, gtChannels)
    var tokensRoot = ast.firstChildWithType(root, gtTokensSpec)
    val actionRoots = ast.nodesWithType(root, gtAt)
    val rules = ast.firstChildWithType(root, gtRules)
    val rootRuleNames: Map<string, bool> = Map()
    for (r in ast.nodesWithType(rules, gtRule)) rootRuleNames.set(ast.text[ast.child(r, 0)], true)
    val rootModes = ast.nodesWithType(root, gtMode)
    val rootModeNames: Map<string, bool> = Map()
    for (m in rootModes) rootModeNames.set(ast.text[ast.child(m, 0)], true)
    for (imp in imports) {
        val iroot = grammars[imp].root
        val ich = ast.firstChildWithType(iroot, gtChannels)
        if (ich >= 0) {
            if (channelsRoot < 0) {
                channelsRoot = ast.dupTree(ich)
                ast.insertChild(root, 1, channelsRoot)
            } else {
                for (c in copyKids(ast.kids[ich])) {
                    var present = false
                    for (rc in ast.kids[channelsRoot]) if (ast.text[rc] == ast.text[c]) present = true
                    if (!present) ast.addChild(channelsRoot, ast.dupNode(c))
                }
            }
        }
        val itk = ast.firstChildWithType(iroot, gtTokensSpec)
        if (itk >= 0) {
            if (tokensRoot < 0) {
                tokensRoot = ast.node(gtTokensSpec, "TOKENS", -1, grammars[gi].sr)
                ast.insertChild(root, 1, tokensRoot)
            }
            for (c in copyKids(ast.kids[itk])) ast.addChild(tokensRoot, c)
        }
        val all: array<int> = []
        for (a in actionRoots) all.append(a)
        for (a in childrenWithType(iroot, gtAt)) all.append(a)
        val keys: array<string> = []
        val actions: array<int> = []
        val ats: array<int> = []
        for (at in all) {
            var scope = if (grammars[gi].kind == gkLexer) "lexer" else "parser"
            var nameNode = ast.child(at, 0)
            var action = ast.child(at, 1)
            if (ast.childCount(at) > 2) {
                scope = ast.text[ast.child(at, 0)]
                nameNode = ast.child(at, 1)
                action = ast.child(at, 2)
            }
            val key = scope + "::" + ast.text[nameNode]
            var prev = -1
            for (i in 0 until keys.size) if (keys[i] == key) prev = i
            if (prev < 0) {
                keys.append(key)
                actions.append(action)
                ats.append(at)
            } else {
                val pa = actions[prev]
                if (grammarOfStream(ast.src[pa]) == grammarOfStream(ast.src[at])) fail("redefinition of action ${ast.text[nameNode]}")
                else {
                    val s1 = ast.text[pa]
                    val s2 = ast.text[action]
                    ast.text[pa] = "{" + s1.slice(1, s1.size - 1) + "\n" + s2.slice(1, s2.size - 1) + "}"
                }
            }
        }
        for (i in 0 until actions.size) {
            if (grammarOfStream(ast.src[actions[i]]) != gi) ast.insertChild(root, 1, ast.parent[actions[i]])
        }
        for (m in ast.nodesWithType(iroot, gtMode)) {
            val name = ast.text[ast.child(m, 0)]
            val has = rootModeNames.has(name)
            var dest = -1
            if (has) {
                for (m2 in rootModes) if (dest < 0 && ast.text[ast.child(m2, 0)] == name) dest = m2
            } else {
                dest = ast.dupNode(m)
                ast.addChild(dest, ast.dupNode(ast.child(m, 0)))
            }
            var added = 0
            for (r in childrenWithType(m, gtRule)) {
                val rn = ast.text[ast.child(r, 0)]
                if (!rootRuleNames.has(rn)) {
                    ast.addChild(dest, r)
                    added += 1
                    rootRuleNames.set(rn, true)
                }
            }
            if (!has && added > 0) {
                ast.addChild(root, dest)
                rootModeNames.set(name, true)
                rootModes.append(dest)
            }
        }
        for (r in ast.nodesWithType(iroot, gtRule)) {
            val rn = ast.text[ast.child(r, 0)]
            if (!rootRuleNames.has(rn)) {
                ast.addChild(rules, r)
                rootRuleNames.set(rn, true)
            }
        }
    }
}

// BlockSetTransformer: (a|b|c) of single tokens or characters becomes a set.
fun G4Tool.isSetElement(e: int, inLexer: bool): bool {
    val t = ast.type[e]
    val n = ast.childCount(e)
    val optsOk = n == 0 || (n == 1 && ast.type[ast.child(e, 0)] == gtElementOptions)
    if (t == gtStringLiteral) return optsOk && (!inLexer || charValueFromLiteral(ast.text[e]) != -1)
    if (t == gtTokenRef) return optsOk && !inLexer
    if (t == gtRange && inLexer && n == 2) {
        val a = ast.child(e, 0)
        val b = ast.child(e, 1)
        return ast.type[a] == gtStringLiteral && ast.type[b] == gtStringLiteral && ast.childCount(a) == 0 && ast.childCount(b) == 0 &&
            charValueFromLiteral(ast.text[a]) != -1 && charValueFromLiteral(ast.text[b]) != -1
    }
    false
}

// The set element of an ALT of the form ^(ALT elementOptions? setElement), or -1
fun G4Tool.altSetElement(alt: int, inLexer: bool): int {
    if (ast.type[alt] != gtAlt) return -1
    val n = ast.childCount(alt)
    var e = -1
    if (n == 1) e = ast.child(alt, 0)
    else if (n == 2 && ast.type[ast.child(alt, 0)] == gtElementOptions) e = ast.child(alt, 1)
    if (e >= 0 && isSetElement(e, inLexer)) e else -1
}

fun G4Tool.blockSetElements(blk: int, ruleLevel: bool): array<int> {
    val elements: array<int> = []
    val inLexer = isTokenName(curRule)
    val n = ast.childCount(blk)
    if (ast.type[blk] != gtBlock || n < 2) return elements
    var ok = true
    for (i in 0 until n) {
        val alt = ast.child(blk, i)
        val e = altSetElement(alt, inLexer)
        if (e < 0) ok = false
        else if (i == 0 && ruleLevel && ast.altLabel[alt] >= 0) ok = false
        if (ok) elements.append(e)
    }
    if (!ok) elements.clear()
    elements
}

fun G4Tool.blockSetTopdown(t: int): int {
    val ty = ast.type[t]
    if (ty == gtRule) {
        if (ast.childCount(t) >= 2) curRule = ast.text[ast.child(t, 0)]
        return t
    }
    if ((ty == gtOptional || ty == gtClosure || ty == gtPositiveClosure) && ast.childCount(t) == 1) {
        val blk = ast.child(t, 0)
        val els = blockSetElements(blk, false)
        if (els.size > 0) {
            val sr = ast.src[t]
            val suffix = ast.dupNode(t)
            val nb = ast.node(gtBlock, "BLOCK", -1, sr)
            ast.withOptions[nb] = true
            val na = ast.node(gtAlt, "ALT", -1, sr)
            ast.withOptions[na] = true
            val set = ast.node(gtSet, "SET", ast.tok[blk], sr)
            for (e in els) ast.addChild(set, e)
            ast.addChild(na, set)
            ast.addChild(nb, na)
            ast.addChild(suffix, nb)
            return suffix
        }
        return t
    }
    if (ty == gtBlock) {
        val p = ast.parent[t]
        val ruleLevel = p >= 0 && ast.type[p] == gtRule
        val els = blockSetElements(t, ruleLevel)
        if (els.size > 0) {
            val sr = ast.src[t]
            val set = ast.node(gtSet, "SET", ast.tok[t], sr)
            for (e in els) ast.addChild(set, e)
            if (!ruleLevel) return set
            val nb = ast.node(gtBlock, ast.text[t], ast.tok[t], sr)
            ast.withOptions[nb] = true
            val na = ast.node(gtAlt, "ALT", ast.tok[t], sr)
            ast.withOptions[na] = true
            ast.addChild(na, set)
            ast.addChild(nb, na)
            return nb
        }
    }
    t
}

fun G4Tool.reduceBlocksToSets(t: int): int {
    val n = blockSetTopdown(t)
    var i = 0
    while (i < ast.childCount(n)) {
        val c = ast.child(n, i)
        val r = reduceBlocksToSets(c)
        if (r != ast.child(n, i)) ast.setChild(n, i, r)
        i += 1
    }
    n
}

// The string literals the grammar's rules reference, in order (getStringLiterals)
fun G4Tool.stringLiterals(root: int): array<string> {
    val order: array<int> = []
    ast.preorder(root, order)
    val result: array<string> = []
    val seen: Map<string, bool> = Map()
    for (n in order) {
        if (ast.type[n] == gtStringLiteral && ast.isAncestorType(n, gtRule) && !ast.isAncestorType(n, gtElementOptions) && !ast.isAncestorType(n, gtOptions)) {
            val p = ast.parent[n]
            var refd = true
            if (p >= 0 && ast.type[p] == gtRange) {
                val gp = ast.parent[p]
                refd = gp >= 0 && ast.type[gp] == gtSet
            }
            if (refd && !seen.has(ast.text[n])) {
                seen.set(ast.text[n], true)
                result.append(ast.text[n])
            }
        }
    }
    result
}

fun G4Tool.isLeaf(n: int, ty: int): bool = n >= 0 && ast.type[n] == ty && ast.childCount(n) == 0

fun G4Tool.isAnyLeaf(n: int): bool = n >= 0 && ast.childCount(n) == 0

fun G4Tool.isCallPattern(n: int): bool =
    n >= 0 && ast.type[n] == gtLexerActionCall && ast.childCount(n) == 2 && isAnyLeaf(ast.child(n, 0)) && isAnyLeaf(ast.child(n, 1))

// getStringLiteralAliasesFromLexerRules: the literal of a rule like A : 'a' ;
fun G4Tool.aliasLiteral(r: int): int {
    if (ast.childCount(r) != 2) return -1
    val name = ast.child(r, 0)
    val blk = ast.child(r, 1)
    if (!isLeaf(name, gtTokenRef) || ast.type[blk] != gtBlock || ast.childCount(blk) != 1) return -1
    val x = ast.child(blk, 0)
    if (ast.type[x] == gtAlt) {
        val n = ast.childCount(x)
        val lit = ast.child(x, 0)
        if (!isLeaf(lit, gtStringLiteral)) return -1
        if (n == 1) return lit
        if (n == 2 && (isLeaf(ast.child(x, 1), gtAction) || isLeaf(ast.child(x, 1), gtSempred))) return lit
        return -1
    }
    if (ast.type[x] == gtLexerAltAction) {
        val alt = ast.child(x, 0)
        if (ast.type[alt] != gtAlt || ast.childCount(alt) != 1 || !isLeaf(ast.child(alt, 0), gtStringLiteral)) return -1
        val lit = ast.child(alt, 0)
        val n = ast.childCount(x)
        if (n == 2) {
            val c = ast.child(x, 1)
            if (isAnyLeaf(c) || isCallPattern(c)) return lit
        } else if (n == 3) {
            val c1 = ast.child(x, 1)
            val c2 = ast.child(x, 2)
            if (isAnyLeaf(c1) && isAnyLeaf(c2)) return lit
            if (isAnyLeaf(c1) && isCallPattern(c2)) return lit
            if (isCallPattern(c1) && isAnyLeaf(c2)) return lit
        }
    }
    -1
}

class G4Alias(val name: string, val lit: string)

fun G4Tool.literalAliases(root: int): array<G4Alias> {
    val result: array<G4Alias> = []
    for (r in ast.nodesWithType(root, gtRule)) {
        val name = ast.child(r, 0)
        if (name >= 0 && ast.type[name] == gtTokenRef) {
            val lit = aliasLiteral(r)
            if (lit >= 0) result.append(G4Alias(ast.text[name], ast.text[lit]))
        }
    }
    result
}

// GrammarTransformPipeline.extractImplicitLexer; returns the lexer grammar or -1
fun G4Tool.extractImplicitLexer(gi: int): int {
    val croot = grammars[gi].root
    val sr = grammars[gi].sr
    val lroot = ast.node(gtGrammar, "LEXER_GRAMMAR", -1, sr)
    ast.withOptions[lroot] = true
    ast.altLabel[lroot] = gkLexer
    val lexerName = grammars[gi].name + "Lexer"
    ast.addChild(lroot, ast.node(gtId, lexerName, -1, sr))
    val options = ast.firstChildWithType(croot, gtOptions)
    if (options >= 0 && ast.childCount(options) != 0) {
        val lopts = ast.dupNode(options)
        ast.addChild(lroot, lopts)
        for (o in copyKids(ast.kids[options])) {
            val name = ast.text[ast.child(o, 0)]
            val lexerOption = name == "contextSuperClass" || name == "language" || name == "accessLevel" || name == "exportMacro"
            if (lexerOption) {
                val tree = ast.dupTree(o)
                ast.addChild(lopts, tree)
                ast.setOption(lroot, name, ast.child(tree, 1))
            }
        }
    }
    val moved: array<int> = []
    for (e in copyKids(ast.kids[croot])) {
        if (ast.type[e] == gtAt) {
            ast.addChild(lroot, ast.dupTree(e))
            if (ast.text[ast.child(e, 0)] == "lexer") moved.append(e)
        }
    }
    for (e in moved) ast.deleteChildNode(croot, e)
    val crules = ast.firstChildWithType(croot, gtRules)
    if (crules < 0) return -1
    val lrules = ast.node(gtRules, "RULES", -1, sr)
    ast.addChild(lroot, lrules)
    val rulesMoved: array<int> = []
    for (r in copyKids(ast.kids[crules])) {
        if (isTokenName(ast.text[ast.child(r, 0)])) {
            ast.addChild(lrules, ast.dupTree(r))
            rulesMoved.append(r)
        }
    }
    for (r in rulesMoved) ast.deleteChildNode(crules, r)
    val aliases = literalAliases(lroot)
    var insertAt = 0
    for (lit in stringLiterals(croot)) {
        var aliased = false
        for (a in aliases) if (a.lit == lit) aliased = true
        if (!aliased) {
            val rname = "T__${grammars[gi].litRuleNumber}"
            grammars[gi].litRuleNumber += 1
            val rule = ast.node(gtRule, "RULE", -1, sr)
            ast.withOptions[rule] = true
            val blk = ast.node(gtBlock, "BLOCK", -1, sr)
            ast.withOptions[blk] = true
            val alt = ast.node(gtAlt, "ALT", -1, sr)
            ast.withOptions[alt] = true
            val slit = ast.node(gtStringLiteral, lit, -1, sr)
            ast.withOptions[slit] = true
            ast.addChild(alt, slit)
            ast.addChild(blk, alt)
            val id = ast.node(gtTokenRef, rname, -1, sr)
            ast.withOptions[id] = true
            ast.addChild(rule, id)
            ast.addChild(rule, blk)
            ast.insertChild(lrules, insertAt, rule)
            insertAt += 1
        }
    }
    if (ast.childCount(lrules) == 0) return -1
    grammars.append(g4Grammar(lexerName, gkLexer, lroot, sr))
    grammars.size - 1
}

// RuleCollector: rules in definition order, then mode by mode.
fun G4Tool.hasImmediateRecursion(r: int, name: string): bool {
    val blk = ast.firstChildWithType(r, gtBlock)
    if (blk < 0) return false
    var found = false
    for (alt in ast.kids[blk]) {
        var first = ast.child(alt, 0)
        if (first >= 0 && ast.type[first] == gtElementOptions) first = ast.child(alt, 1)
        if (first >= 0) {
            if (ast.type[first] == gtRuleRef && ast.text[first] == name) found = true
            val rref = ast.child(first, 1)
            if (rref >= 0 && ast.type[rref] == gtRuleRef && ast.text[rref] == name) found = true
        }
    }
    found
}

fun G4Tool.addRule(gi: int, r: int, mode: string): void {
    val idNode = ast.child(r, 0)
    val name = ast.text[idNode]
    if (grammars[gi].ruleIndex.has(name)) return
    val isLexerRule = ast.type[idNode] == gtTokenRef
    var fragment = false
    val mods = ast.firstChildWithType(r, gtRuleModifiers)
    if (mods >= 0) for (m in ast.kids[mods]) if (ast.type[m] == gtFragment) fragment = true
    grammars[gi].ruleIndex.set(name, grammars[gi].ruleNames.size)
    grammars[gi].ruleNames.append(name)
    grammars[gi].ruleAst.append(r)
    grammars[gi].ruleMode.append(mode)
    grammars[gi].ruleFragment.append(fragment)
    grammars[gi].ruleLr.append(!isLexerRule && hasImmediateRecursion(r, name))
}

fun G4Tool.collectRules(gi: int): void {
    val root = grammars[gi].root
    val rules = ast.firstChildWithType(root, gtRules)
    if (rules >= 0) for (r in copyKids(ast.kids[rules])) if (ast.type[r] == gtRule) addRule(gi, r, defaultModeName)
    for (m in copyKids(ast.kids[root])) {
        if (ast.type[m] == gtMode) {
            val modeName = ast.text[ast.child(m, 0)]
            for (r in copyKids(ast.kids[m])) if (ast.type[r] == gtRule) addRule(gi, r, modeName)
        }
    }
    if (grammars[gi].kind == gkLexer) {
        for (i in 0 until grammars[gi].ruleNames.size) {
            val mode = grammars[gi].ruleMode[i]
            var at = grammars[gi].modeIndex(mode)
            if (at < 0) {
                grammars[gi].modeNames.append(mode)
                grammars[gi].modeRules.append([])
                at = grammars[gi].modeNames.size - 1
            }
            grammars[gi].modeRules[at].append(i)
        }
    }
}

// LeftRecursiveRuleAnalyzer / LeftRecursiveRuleTransformer
val lrOther = 0
val lrBinary = 1
val lrPrefix = 2
val lrSuffix = 3

fun G4Tool.isRecurse(n: int, name: string): bool {
    val t = ast.type[n]
    if (t == gtRuleRef) return ast.text[n] == name && ast.childCount(n) == 0
    if (t == gtAssign || t == gtPlusAssign) {
        val c = ast.child(n, 1)
        return c >= 0 && ast.type[c] == gtRuleRef && ast.text[c] == name && ast.childCount(c) == 0
    }
    false
}

fun G4Tool.isEpsilonElement(n: int): bool {
    val t = ast.type[n]
    t == gtAction || t == gtSempred || t == gtEpsilon
}

fun G4Tool.lrKind(alt: int, name: string): int {
    val elems: array<int> = []
    for (c in ast.kids[alt]) if (ast.type[c] != gtElementOptions || elems.size > 0) elems.append(c)
    val n = elems.size
    var last = n - 1
    while (last >= 0 && isEpsilonElement(elems[last])) last -= 1
    val firstRec = n > 0 && isRecurse(elems[0], name)
    val lastRec = last >= 1 && isRecurse(elems[last], name)
    if (firstRec && lastRec) lrBinary
    else if (lastRec) lrPrefix
    else if (firstRec && n >= 2) lrSuffix
    else lrOther
}

fun G4Tool.stripLeftRecursion(alt: int, name: string): void {
    var idx = 0
    var first = ast.child(alt, 0)
    if (ast.type[first] == gtElementOptions) {
        first = ast.child(alt, 1)
        idx = 1
    }
    val rref = ast.child(first, 1)
    if ((ast.type[first] == gtRuleRef && ast.text[first] == name) || (rref >= 0 && ast.type[rref] == gtRuleRef && ast.text[rref] == name)) {
        ast.deleteChild(alt, idx)
        val nf = ast.child(alt, idx)
        if (nf >= 0) ast.start[alt] = ast.startIndex(nf)
    }
}

fun G4Tool.stripAltLabel(alt: int): void {
    val toks = ast.src[alt]
    val a = ast.startIndex(alt)
    var i = ast.stopIndex(alt)
    var done = false
    while (!done && i >= a) {
        if (i >= 0 && i < ast.streams[toks].count() && ast.streams[toks].type[i] == gtPound) {
            ast.stop[alt] = i - 1
            done = true
        }
        i -= 1
    }
}

fun G4Tool.addPrecedenceArg(alt: int, name: string, prec: int): void {
    val order: array<int> = []
    ast.preorder(alt, order)
    var last = -1
    for (n in order) if (ast.type[n] == gtRuleRef) last = n
    if (last >= 0 && ast.text[last] == name) {
        val v = ast.node(gtInt, "$prec", -1, ast.src[alt])
        ast.setOption(last, "p", v)
    }
}

// LeftRecursiveRuleAnalyzer.text: the alternative's tokens, element options rewritten
fun G4Tool.lrText(t: int): string {
    val sr = ast.src[t]
    val from = ast.startIndex(t)
    val to = ast.stopIndex(t)
    val ignore = intervalSet()
    for (sub in ast.nodesWithType(t, gtElementOptions)) {
        if (ast.startIndex(sub) <= ast.stopIndex(sub)) ignore.addRange(ast.startIndex(sub), ast.stopIndex(sub))
    }
    val noOptions = intervalSet()
    for (sub in ast.nodesWithType(t, gtAssign)) noOptions.addOne(ast.startIndex(ast.child(sub, 0)))
    for (sub in ast.nodesWithType(t, gtPlusAssign)) noOptions.addOne(ast.startIndex(ast.child(sub, 0)))
    val parts: array<string> = []
    var i = from
    while (i <= to) {
        if (ignore.contains(i)) i += 1
        else {
            val ty = ast.streams[sr].type[i]
            var eo = ""
            if (!noOptions.contains(i)) {
                val node = ast.nodeWithTokenIndex(t, i)
                if (node >= 0 && (ty == gtTokenRef || ty == gtStringLiteral || ty == gtRuleRef)) eo = "tokenIndex=$i"
                if (node >= 0 && ast.withOptions[node]) {
                    for (k in 0 until ast.optKeys[node].size) {
                        if (eo.size > 0) eo = eo + ","
                        val v = ast.optVals[node][k]
                        eo = eo + ast.optKeys[node][k] + "=" + (if (v >= 0) ast.text[v] else "")
                    }
                }
            }
            parts.append(ast.streams[sr].text[i])
            i += 1
            if (ty == gtRuleRef && i <= to && ast.streams[sr].type[i] == gtArgAction) {
                parts.append("[" + ast.streams[sr].text[i] + "]")
                i += 1
            }
            if (eo.size > 0) parts.append("<" + eo + ">")
        }
    }
    textJoin(parts, "")
}

fun G4Tool.translateLeftRecursive(gi: int, r: int): bool {
    val ruleNode = grammars[gi].ruleAst[r]
    val name = grammars[gi].ruleNames[r]
    var retvals = -1
    for (c in ast.kids[ruleNode]) {
        val t = ast.type[c]
        if (t == gtArgAction || t == gtThrows) return false
        if (t == gtReturns) retvals = ast.child(c, 0)
    }
    val blk = ast.firstChildWithType(ruleNode, gtBlock)
    val numAlts = ast.childCount(blk)
    val primary: array<string> = []
    val binaryAlts: array<string> = []
    val binaryPrec: array<int> = []
    val suffixAlts: array<string> = []
    val suffixPrec: array<int> = []
    for (k in 0 until numAlts) {
        val original = ast.child(blk, k)
        val alt = k + 1
        val kind = lrKind(original, name)
        val prec = numAlts - alt + 1
        var right = false
        if (kind != lrOther) {
            val a = ast.optionString(original, "assoc")
            if (a != null && a == "right") right = true
        }
        val tree = ast.dupTree(original)
        if (kind == lrBinary) {
            stripLeftRecursion(tree, name)
            stripAltLabel(tree)
            addPrecedenceArg(tree, name, if (right) prec else prec + 1)
            stripAltLabel(tree)
            binaryAlts.append(javaTrim(lrText(tree)))
            binaryPrec.append(prec)
        } else if (kind == lrPrefix) {
            stripAltLabel(tree)
            addPrecedenceArg(tree, name, prec)
            primary.append(javaTrim(lrText(tree)))
        } else if (kind == lrSuffix) {
            stripLeftRecursion(tree, name)
            stripAltLabel(tree)
            suffixAlts.append(javaTrim(lrText(tree)))
            suffixPrec.append(prec)
        } else {
            stripAltLabel(tree)
            primary.append(lrText(tree))
        }
    }
    if (binaryAlts.size == 0 && suffixAlts.size == 0) return false
    var text = name
    if (retvals >= 0) text = text + " returns [" + ast.text[retvals] + "]"
    text = text + "\n    :   ( {} "
    for (i in 0 until primary.size) {
        if (i > 0) text = text + "\n        | "
        text = text + primary[i] + " "
    }
    text = text + "\n        )\n        (\n          "
    var first = true
    for (i in 0 until binaryAlts.size) {
        if (!first) text = text + "\n        | "
        first = false
        text = text + "{precpred(_ctx, ${binaryPrec[i]})}?<p=${binaryPrec[i]}> " + binaryAlts[i]
    }
    for (i in 0 until suffixAlts.size) {
        if (!first) text = text + "\n        | "
        first = false
        text = text + "{precpred(_ctx, ${suffixPrec[i]})}?<p=${suffixPrec[i]}> " + suffixAlts[i]
    }
    text = text + "\n        )*\n    ;\n"
    val nsr = ast.addStream(g4Lex(sourceText(text)))
    val errs: array<string> = []
    val t = g4ParseRule(ast, nsr, errs)
    if (t < 0) {
        fail("error parsing rule created during left-recursion detection: ${errs[0]}")
        return true
    }
    val rules = ast.parent[ruleNode]
    val at = ast.childIndex(ruleNode)
    if (rules >= 0 && at >= 0) ast.setChild(rules, at, t)
    grammars[gi].ruleAst[r] = t
    reduceBlocksToSets(t)
    true
}

fun G4Tool.translateLeftRecursiveRules(gi: int): void {
    for (r in 0 until grammars[gi].ruleNames.size) {
        if (grammars[gi].ruleLr[r] && !translateLeftRecursive(gi, r)) fail("rule ${grammars[gi].ruleNames[r]}: left recursion in a form the tool can't rewrite")
    }
}

class G4Symbols(var tokensDefs: array<string>, var tokenRefs: array<string>, var channelDefs: array<string>)

// SymbolCollector, for the parts the ATN needs.
fun G4Tool.collectSymbols(gi: int): G4Symbols {
    val syms = G4Symbols([], [], [])
    val order: array<int> = []
    ast.preorder(grammars[gi].root, order)
    val lexer = grammars[gi].kind == gkLexer
    for (n in order) {
        val t = ast.type[n]
        val p = ast.parent[n]
        val pt = if (p >= 0) ast.type[p] else -1
        if (t == gtTokensSpec) {
            for (c in ast.kids[n]) {
                syms.tokensDefs.append(ast.text[c])
                syms.tokenRefs.append(ast.text[c])
            }
        } else if (t == gtChannels) {
            for (c in ast.kids[n]) syms.channelDefs.append(ast.text[c])
        } else if (t == gtTokenRef && pt != gtRule && ast.isAncestorType(n, gtRule)) syms.tokenRefs.append(ast.text[n])
        else if (t == gtSempred && pt == gtAlt) grammars[gi].sempreds.append(n)
        else if (t == gtAction && pt == gtAlt && lexer) grammars[gi].lexerActions.append(n)
    }
    syms
}

fun hasTypeOrMore(ast: G4Ast, r: int): bool {
    val a = ast.firstDescendantWithType(r, gtLexerAltAction)
    if (a < 0) return false
    var found = false
    for (i in 1 until ast.childCount(a)) {
        val c = ast.child(a, i)
        if (ast.type[c] == gtLexerActionCall) {
            if (ast.text[ast.child(c, 0)] == "type") found = true
        } else if (ast.text[c] == "more") found = true
    }
    found
}

fun G4Tool.assignLexerTokenTypes(gi: int, syms: G4Symbols): void {
    for (d in copyStringList(syms.tokensDefs)) if (isTokenName(d)) grammars[gi].defineTokenName(d)
    for (r in 0 until grammars[gi].ruleNames.size) {
        if (!grammars[gi].ruleFragment[r] && !hasTypeOrMore(ast, grammars[gi].ruleAst[r])) grammars[gi].defineTokenName(grammars[gi].ruleNames[r])
    }
    val conflicting: array<string> = []
    for (a in literalAliases(grammars[gi].root)) {
        if (!grammars[gi].literals.has(a.lit)) grammars[gi].defineTokenAlias(a.name, a.lit)
        else {
            var seen = false
            for (c in conflicting) if (c == a.lit) seen = true
            if (!seen) conflicting.append(a.lit)
        }
    }
    for (lit in conflicting) {
        val v = grammars[gi].literals.get(lit)
        grammars[gi].literals.remove(lit)
        if (v != null && v > 0 && v < grammars[gi].typeToLiteral.size) {
            val cur = grammars[gi].typeToLiteral[v]
            if (cur != null && cur == lit) grammars[gi].typeToLiteral[v] = null
        }
    }
}

fun G4Tool.importVocab(gi: int, from: int): void {
    for (k in copyStringList(grammars[from].tokenNames.keys())) {
        val v = grammars[from].tokenNames.get(k)
        if (v != null) grammars[gi].defineTokenNameType(k, v)
    }
    for (k in copyStringList(grammars[from].literals.keys())) {
        val v = grammars[from].literals.get(k)
        if (v != null) grammars[gi].defineStringLiteralType(k, v)
    }
    for (k in copyStringList(grammars[from].channels.keys())) {
        val v = grammars[from].channels.get(k)
        if (v != null) grammars[gi].defineChannelNameValue(k, v)
    }
    val n = grammars[from].typeToToken.size
    while (grammars[gi].typeToToken.size < n) grammars[gi].typeToToken.append(null)
    for (t in 0 until n) {
        if (t > grammars[gi].maxTokenType) grammars[gi].maxTokenType = t
        grammars[gi].typeToToken[t] = grammars[from].typeToToken[t]
    }
    val m = grammars[from].channelToName.size
    while (grammars[gi].channelToName.size < m) grammars[gi].channelToName.append(null)
    for (c in 0 until m) {
        if (c > grammars[gi].maxChannel) grammars[gi].maxChannel = c
        grammars[gi].channelToName[c] = grammars[from].channelToName[c]
    }
}

fun copyStringList(xs: array<string>): array<string> {
    val r: array<string> = []
    for (x in xs) r.append(x)
    r
}

// One line of a .tokens file: NAME=type, matched as TokenVocabParser's pattern
class G4VocabEntry(val name: string, val type: int)

fun vocabLine(line: string): G4VocabEntry? {
    var l = 1
    while (l < line.size) {
        var k = l
        while (k < line.size && (line[k] == 32 || line[k] == 9)) k += 1
        if (k < line.size && line[k] == 61) {
            k += 1
            while (k < line.size && (line[k] == 32 || line[k] == 9)) k += 1
            var v = 0
            var digits = 0
            while (k < line.size && line[k] >= 48 && line[k] <= 57) {
                v = v * 10 + (line[k] - 48)
                digits += 1
                k += 1
            }
            if (digits > 0) return G4VocabEntry(line.slice(0, l), v)
        }
        l += 1
    }
    null
}

class G4Output(
    var lexerInterp: string,
    var parserInterp: string,
    var vocab: string,
    var lexerActions: array<string>,
    var lexerPredicates: array<string>,
    var parserPredicates: array<string>,
    var parserActionStates: array<int>,
    var parserActions: array<string>,
    var error: string
)

fun g4Output(): G4Output = G4Output("", "", "", [], [], [], [], [], "")
