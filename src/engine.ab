// Parser state: the token stream, the parse tree and the prediction caches.

import "atn.ab"
import "context.ab"
import "semantic.ab"
import "configs.ab"
import "lexer.ab"
import "grammar.ab"
import "intervalset.ab"

val excNone = 0
val excNoViableAlt = 1
val excInputMismatch = 2
val excFailedPredicate = 3

class SyntaxErr(val line: int, val column: int, val message: string)

// Tokens conjured by error recovery live apart from the stream, from this id on.
val conjuredBase = 1099511627776

class Engine(
    var lexer: Lexer,
    val lexerAtn: Atn,
    var fetchedEof: bool,
    var missing: Tokens,
    var messages: array<SyntaxErr>,
    var lexerErrorCount: int,
    var contexts: ContextPool,
    var sems: SemanticPool,
    var configs: ConfigPool,
    var dfas: array<Dfa>,
    var tokens: Tokens,
    var streamCount: int,
    var index: int,
    var ctxRule: array<int>,
    var ctxParent: array<int>,
    var ctxInvoking: array<int>,
    var ctxStart: array<int>,
    var ctxStop: array<int>,
    var ctxAlt: array<int>,
    var ctxChildren: array<array<int>>,
    var cur: int,
    var state: int,
    var precStack: array<int>,
    var recovering: bool,
    var lastErrorIndex: int,
    var lastErrorStates: array<int>,
    var hasLastErrorStates: bool,
    var exc: int,
    var excStart: int,
    var excOffending: int,
    var excState: int,
    var excCtx: int,
    var excMessage: string,
    var errors: array<SyntaxErr>,
    var predictStart: int,
    var predictOuter: int,
    var predictDfa: int,
    var conflictCounter: int,
    var frameParent: array<int>,
    var frameParentState: array<int>,
    var frameStart: array<int>
) {
    // CommonTokenStream over the default channel, filled from the lexer on demand

    fun tokType(t: int): int = if (t >= conjuredBase) missing.type[t - conjuredBase] else tokens.type[t]

    fun tokText(t: int): string = if (t >= conjuredBase) missing.text[t - conjuredBase] else tokens.text[t]

    fun tokLine(t: int): int = if (t >= conjuredBase) missing.line[t - conjuredBase] else tokens.line[t]

    fun tokColumn(t: int): int = if (t >= conjuredBase) missing.column[t - conjuredBase] else tokens.column[t]

    fun tokChannel(t: int): int = if (t >= conjuredBase) missing.channel[t - conjuredBase] else tokens.channel[t]

    fun tokIndex(t: int): int = if (t >= conjuredBase) -1 else tokens.tokenIndex[t]

    fun tokStart(t: int): int = if (t >= conjuredBase) missing.start[t - conjuredBase] else tokens.start[t]

    fun tokStop(t: int): int = if (t >= conjuredBase) missing.stop[t - conjuredBase] else tokens.stop[t]

    fun fetchOne(): void {
        lexer.nextToken(lexerAtn)
        val k = lexer.out.count() - 1
        val ty = lexer.out.type[k]
        tokens.add(ty, lexer.out.channel[k], lexer.out.start[k], lexer.out.stop[k], lexer.out.line[k], lexer.out.column[k], lexer.out.text[k], tokens.count())
        streamCount = tokens.count()
        while (lexerErrorCount < lexer.errors.size) {
            val e = lexer.errors[lexerErrorCount]
            messages.append(SyntaxErr(e.line, e.column, e.message))
            lexerErrorCount += 1
        }
        if (ty == tokenEof) fetchedEof = true
    }

    fun syncTo(i: int): bool {
        while (i >= streamCount && !fetchedEof) fetchOne()
        i < streamCount
    }

    fun fill(): void {
        while (!fetchedEof) fetchOne()
    }

    fun nextOnChannel(from: int): int {
        var i = from
        syncTo(i)
        if (i >= streamCount) return -1
        var going = true
        while (going && tokens.channel[i] != defaultChannel) {
            if (tokens.type[i] == tokenEof) {
                i = -1
                going = false
            } else {
                i += 1
                syncTo(i)
            }
        }
        i
    }

    fun previousOnChannel(from: int): int {
        var i = from
        while (i >= 0 && tokens.channel[i] != defaultChannel) i -= 1
        i
    }

    fun seek(i: int): void {
        index = nextOnChannel(i)
    }

    fun lt(k: int): int {
        var result = -1
        if (k > 0) {
            var i = index
            var n = 1
            while (n < k) {
                if (syncTo(i + 1)) i = nextOnChannel(i + 1)
                n += 1
            }
            result = i
        } else if (k < 0) {
            if (index + k >= 0) {
                var i = index
                var n = 1
                while (n <= -k) {
                    i = previousOnChannel(i - 1)
                    n += 1
                }
                if (i >= 0) result = i
            }
        }
        result
    }

    fun la(k: int): int = tokType(lt(k))

    fun streamConsume(): void {
        if (syncTo(index + 1)) index = nextOnChannel(index + 1)
    }

    fun conjure(ty: int, line: int, column: int, text: string): int {
        missing.add(ty, defaultChannel, -1, -1, line, column, text, -1)
        conjuredBase + missing.count() - 1
    }

    // parse tree

    fun newContext(rule: int, parent: int, invoking: int): int {
        val id = ctxRule.size
        ctxRule.append(rule)
        ctxParent.append(parent)
        ctxInvoking.append(if (invoking == 0) -1 else invoking)
        ctxStart.append(-1)
        ctxStop.append(-1)
        ctxAlt.append(0)
        ctxChildren.append([])
        id
    }

    fun addChild(parent: int, child: int): void {
        ctxChildren[parent].append(child)
    }

    fun addTokenNode(token: int, error: bool): void {
        ctxChildren[cur].append(if (error) -2 - 2 * token else -1 - 2 * token)
    }

    fun precedence(): int = if (precStack.size == 0) -1 else precStack[precStack.size - 1]

    fun precpred(p: int): bool = p >= precStack[precStack.size - 1]

    fun notify(msg: string, token: int): void {
        val e = SyntaxErr(tokLine(token), tokColumn(token), msg)
        errors.append(e)
        messages.append(SyntaxErr(e.line, e.column, e.message))
    }

    fun throwNoViableAlt(start: int, offending: int, ctx: int): bool {
        exc = excNoViableAlt
        excStart = start
        excOffending = offending
        excState = state
        excCtx = ctx
        false
    }

    fun throwInputMismatch(): bool {
        exc = excInputMismatch
        excOffending = lt(1)
        excState = state
        excCtx = cur
        false
    }

    fun throwFailedPredicate(message: string): bool {
        exc = excFailedPredicate
        excOffending = lt(1)
        excState = state
        excCtx = cur
        excMessage = message
        false
    }
}

fun engine(lexer: Lexer, lexerAtn: Atn, dfas: array<Dfa>): Engine = Engine(
    lexer, lexerAtn, false, tokens(), [], 0,
    contextPool(), semanticPool(), configPool(), dfas, tokens(), 0, 0,
    [], [], [], [], [], [], [], -1, -1, [0],
    false, -1, [], false,
    excNone, -1, -1, -1, -1, "",
    [], 0, -1, -1, 0,
    [], [], []
)
