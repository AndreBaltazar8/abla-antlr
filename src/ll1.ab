// LL1Analyzer: the tokens that can follow an ATN state.

import "atn.ab"
import "context.ab"
import "intervalset.ab"

val hitPred = 0

class LookWalk(var busy: Map<int, bool>, var called: array<bool>, val stopState: int, val seeThruPreds: bool, val addEof: bool)

fun lookRec(atn: Atn, var contexts: ContextPool, var w: LookWalk, var look: IntervalSet, s: int, ctx: int): void {
    val key = s * 4294967296 + (ctx + 1)
    if (w.busy.has(key)) return
    w.busy.set(key, true)
    if (s == w.stopState) {
        if (ctx == ctxNull) {
            look.addOne(tokenEpsilon)
            return
        } else if (contexts.isEmpty(ctx) && w.addEof) {
            look.addOne(tokenEof)
            return
        }
    }
    if (atn.stateType[s] == stRuleStop) {
        if (ctx == ctxNull) {
            look.addOne(tokenEpsilon)
            return
        } else if (contexts.isEmpty(ctx) && w.addEof) {
            look.addOne(tokenEof)
            return
        }
        if (ctx != ctxEmpty) {
            val rule = atn.stateRule[s]
            val removed = w.called[rule]
            w.called[rule] = false
            for (i in 0 until contexts.length(ctx)) {
                val rs = contexts.getReturnState(ctx, i)
                val p = contexts.getParent(ctx, i)
                lookRec(atn, contexts, w, look, rs, p)
            }
            if (removed) w.called[rule] = true
            return
        }
    }
    for (t in atn.stateTrans[s]) {
        val k = atn.transType[t]
        if (k == trRule) {
            val rule = atn.stateRule[atn.transTarget[t]]
            if (!w.called[rule]) {
                val next = contexts.singleton(ctx, atn.transFollow[t])
                w.called[rule] = true
                lookRec(atn, contexts, w, look, atn.transTarget[t], next)
                w.called[rule] = false
            }
        } else if (k == trPredicate || k == trPrecedence) {
            if (w.seeThruPreds) lookRec(atn, contexts, w, look, atn.transTarget[t], ctx)
            else look.addOne(hitPred)
        } else if (k == trEpsilon || k == trAction) {
            lookRec(atn, contexts, w, look, atn.transTarget[t], ctx)
        } else if (k == trWildcard) {
            look.addRange(tokenMinUserType, atn.maxTokenType)
        } else {
            val label = atn.transLabel[t]
            if (label != null) {
                if (k == trNotSet) look.addSet(label.complement(tokenMinUserType, atn.maxTokenType))
                else look.addSet(label)
            }
        }
    }
}

fun lookWalk(atn: Atn, stopState: int, seeThruPreds: bool, addEof: bool): LookWalk {
    val rules = atn.ruleToStart.size
    LookWalk(Map(), filledArray(rules, false), stopState, seeThruPreds, addEof)
}

// LL1Analyzer.LOOK(s, stopState, ctx) with ctx already a prediction context
// (ctxNull when there is no rule context).
fun lookahead(atn: Atn, var contexts: ContextPool, s: int, stopState: int, ctx: int): IntervalSet {
    val w = lookWalk(atn, stopState, true, true)
    val look = intervalSet()
    lookRec(atn, contexts, w, look, s, ctx)
    look
}

// The tool's per-alternative lookahead for a decision; null where an
// alternative sees a predicate or nothing.
fun decisionLookahead(atn: Atn, var contexts: ContextPool, s: int): array<IntervalSet?> {
    val result: array<IntervalSet?> = []
    for (t in atn.stateTrans[s]) {
        val w = lookWalk(atn, -1, false, false)
        val look = intervalSet()
        lookRec(atn, contexts, w, look, atn.transTarget[t], ctxEmpty)
        if (look.isNil() || look.contains(hitPred)) result.append(null)
        else result.append(look)
    }
    result
}

fun disjointLookahead(sets: array<IntervalSet?>): bool {
    var ok = true
    val combined = intervalSet()
    for (look in sets) {
        if (ok) {
            if (look == null) ok = false
            else if (look.intersects(combined)) ok = false
            else combined.addSet(look)
        }
    }
    ok
}
