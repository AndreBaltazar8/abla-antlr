fun unicodeDigit(c: int): int =
    if (c >= 48 && c <= 57) c - 48
    else if (c >= 97 && c <= 122) c - 87
    else if (c >= 65 && c <= 90) c - 29
    else if (c == 45) 62
    else 63

// The ranges of a property by its normalized name, or null.
fun unicodeRangesByName(key: string): IntervalSet? {
    val at = unicodePropertyRanges.indexOf(";" + key + ":")
    if (at < 0) return null
    var i = at + key.size + 2
    val set = intervalSet()
    var prev = -1
    var v = 0
    var gap = -1
    while (i < unicodePropertyRanges.size && unicodePropertyRanges[i] != 59) {
        val d = unicodeDigit(unicodePropertyRanges[i])
        if (d >= 32) v = v * 32 + (d - 32)
        else {
            v = v * 32 + d
            if (gap < 0) gap = v
            else {
                val a = prev + 1 + gap
                set.addRange(a, a + v)
                prev = a + v
                gap = -1
            }
            v = 0
        }
        i += 1
    }
    set
}

// UnicodeData.getPropertyCodePoints: a general category, binary property,
// script or block, by name or alias.
fun unicodePropertySet(name: string): IntervalSet? {
    var key = ""
    for (c in name) {
        if (c >= 65 && c <= 90) key = key + utf8Encode(c + 32)
        else if (c == 45) key = key + "_"
        else key = key + utf8Encode(c)
    }
    val direct = unicodeRangesByName(key)
    if (direct != null) return direct
    val at = unicodePropertyAliases.indexOf(";" + key + " ")
    if (at < 0) return null
    val from = at + key.size + 2
    var to = from
    while (to < unicodePropertyAliases.size && unicodePropertyAliases[to] != 59) to += 1
    unicodeRangesByName(unicodePropertyAliases.slice(from, to))
}
