// The action language's evaluator for one host (HOST), generated from
// src/script_eval.tmpl by tools/gen_script_eval.sh: edit the template.
// The host answers what this, $attributes and runtime values mean through
// hostThisGet/Set/Call, hostAttrGet/Set, hostMemberGet, hostMethodCall,
// hostGlobal, hostPrint, hostStringOf and hostFail, each given the host's
// grammar data (AUX) as aux.

fun HOST.scriptString(aux: AUX, v: SVal): string {
    val k = v.kind
    if (k == svUndefined) return "undefined"
    if (k == svNull) return "null"
    if (k == svBool) return if (v.n != 0) "true" else "false"
    if (k == svNum) return "${v.n}"
    if (k == svStr) return v.s
    if (k == svFn) return "function"
    if (k == svList) {
        val parts: array<string> = []
        for (i in v.items) parts.append(if (i.kind == svNull || i.kind == svUndefined) "" else scriptString(aux, i))
        return textJoin(parts, ",")
    }
    hostStringOf(aux, v)
}

fun HOST.scriptBinary(aux: AUX, op: string, a: SVal, b: SVal): SVal {
    if (op == "+") {
        if ((a.kind == svNum || a.kind == svBool) && (b.kind == svNum || b.kind == svBool)) return svNumber(a.n + b.n)
        return svString(scriptString(aux, a) + scriptString(aux, b))
    }
    if (op == "-") return svNumber(svNumberOf(a) - svNumberOf(b))
    if (op == "*") return svNumber(svNumberOf(a) * svNumberOf(b))
    if (op == "/") {
        val d = svNumberOf(b)
        return svNumber(if (d == 0) 0 else svNumberOf(a) / d)
    }
    if (op == "%") {
        val d = svNumberOf(b)
        return svNumber(if (d == 0) 0 else svNumberOf(a) % d)
    }
    if (op == "===") return svBoolean(svStrictEquals(a, b))
    if (op == "!==") return svBoolean(!svStrictEquals(a, b))
    if (op == "==") return svBoolean(svLooseEquals(a, b))
    if (op == "!=") return svBoolean(!svLooseEquals(a, b))
    if (a.kind == svStr && b.kind == svStr) {
        if (op == "<") return svBoolean(a.s < b.s)
        if (op == ">") return svBoolean(a.s > b.s)
        if (op == "<=") return svBoolean(a.s <= b.s)
        return svBoolean(a.s >= b.s)
    }
    val x = svNumberOf(a)
    val y = svNumberOf(b)
    if (op == "<") return svBoolean(x < y)
    if (op == ">") return svBoolean(x > y)
    if (op == "<=") return svBoolean(x <= y)
    svBoolean(x >= y)
}

fun HOST.scriptCallFunction(aux: AUX, code: ScriptCode, f: SVal, args: array<SVal>): SVal {
    val env = scriptEnv()
    val params = code.str[f.n].split(",")
    for (i in 0 until params.size) {
        if (params[i].size > 0) {
            env.names.append(params[i])
            env.values.append(if (i < args.size) svCopy(args[i]) else svUndef())
        }
    }
    scriptExec(aux, code, env, code.kids[f.n][0])
    svCopy(env.result)
}

fun HOST.scriptValueMember(aux: AUX, obj: SVal, name: string): SVal {
    if (obj.kind == svStr && name == "length") return svNumber(obj.s.size)
    if (obj.kind == svList && name == "length") return svNumber(obj.items.size)
    if (obj.kind == svToken || obj.kind == svCtx || obj.kind == svHost) return hostMemberGet(aux, obj, name)
    svUndef()
}

fun HOST.scriptValueCall(aux: AUX, obj: SVal, name: string, args: array<SVal>): SVal {
    if (name == "toString" && args.size == 0 && obj.kind != svToken && obj.kind != svCtx && obj.kind != svHost) return svString(scriptString(aux, obj))
    if (obj.kind == svStr && name == "equals" && args.size == 1) return svBoolean(obj.s == scriptString(aux, args[0]))
    if (obj.kind == svToken || obj.kind == svCtx || obj.kind == svHost) return hostMethodCall(aux, obj, name, args)
    hostFail(aux, "no method $name")
    svUndef()
}

fun HOST.scriptCallThis(aux: AUX, code: ScriptCode, name: string, args: array<SVal>): SVal {
    val f = hostThisGet(aux, name)
    if (f.kind == svFn) return scriptCallFunction(aux, code, f, args)
    hostThisCall(aux, name, args)
}

fun HOST.scriptEval(aux: AUX, code: ScriptCode, var env: ScriptEnv, n: int): SVal {
    val k = code.kind[n]
    if (k == snNum) return svNumber(code.num[n])
    if (k == snStr) return svString(code.str[n])
    if (k == snBool) return svBoolean(code.num[n] != 0)
    if (k == snNull) return svNullValue()
    if (k == snUndefined) return svUndef()
    if (k == snThis) return svHostObject("this", 0)
    if (k == snName) {
        val i = env.lookup(code.str[n])
        if (i >= 0) return svCopy(env.values[i])
        return hostGlobal(aux, code.str[n])
    }
    if (k == snAttr) return hostAttrGet(aux, code.str[n])
    if (k == snMember) {
        val target = code.kids[n][0]
        if (code.kind[target] == snThis) return hostThisGet(aux, code.str[n])
        val obj = scriptEval(aux, code, env, target)
        if (obj.kind == svHost && obj.s == "this") return hostThisGet(aux, code.str[n])
        return scriptValueMember(aux, obj, code.str[n])
    }
    if (k == snCall) {
        val callee = code.kids[n][0]
        val args: array<SVal> = []
        for (i in 1 until code.kids[n].size) args.append(scriptEval(aux, code, env, code.kids[n][i]))
        if (code.kind[callee] == snName) {
            val name = code.str[callee]
            val local = env.lookup(name)
            if (local >= 0) {
                val f = svCopy(env.values[local])
                if (f.kind == svFn) return scriptCallFunction(aux, code, f, args)
            }
            if (name == "println" || name == "print") {
                val text = if (args.size > 0) scriptString(aux, args[0]) else ""
                hostPrint(aux, if (name == "println") text + "\n" else text)
                return svUndef()
            }
            if (name == "assert") {
                if (args.size == 0 || !svTruthy(args[0])) hostFail(aux, "Assertion failed")
                return svUndef()
            }
            if (name == "assertList") {
                if (args.size == 0 || args[0].kind != svList) hostFail(aux, "value is not an array")
                return svUndef()
            }
            return scriptCallThis(aux, code, name, args)
        }
        if (code.kind[callee] == snMember) {
            val name = code.str[callee]
            val target = code.kids[callee][0]
            if (code.kind[target] == snThis) return scriptCallThis(aux, code, name, args)
            val obj = scriptEval(aux, code, env, target)
            if (obj.kind == svHost && obj.s == "this") return scriptCallThis(aux, code, name, args)
            return scriptValueCall(aux, obj, name, args)
        }
        val f = scriptEval(aux, code, env, callee)
        if (f.kind == svFn) return scriptCallFunction(aux, code, f, args)
        hostFail(aux, "not a function")
        return svUndef()
    }
    if (k == snIndex) {
        val obj = scriptEval(aux, code, env, code.kids[n][0])
        val idx = svNumberOf(scriptEval(aux, code, env, code.kids[n][1]))
        if (obj.kind == svList && idx >= 0 && idx < obj.items.size) return svCopy(obj.items[idx])
        if (obj.kind == svCtx || obj.kind == svToken || obj.kind == svHost) return hostMethodCall(aux, obj, "[]", [svNumber(idx)])
        return svUndef()
    }
    if (k == snUnary) {
        val v = scriptEval(aux, code, env, code.kids[n][0])
        if (code.str[n] == "!") return svBoolean(!svTruthy(v))
        return svNumber(-svNumberOf(v))
    }
    if (k == snBinary) {
        val a = scriptEval(aux, code, env, code.kids[n][0])
        val b = scriptEval(aux, code, env, code.kids[n][1])
        return scriptBinary(aux, code.str[n], a, b)
    }
    if (k == snAnd) {
        val a = scriptEval(aux, code, env, code.kids[n][0])
        if (!svTruthy(a)) return a
        return scriptEval(aux, code, env, code.kids[n][1])
    }
    if (k == snOr) {
        val a = scriptEval(aux, code, env, code.kids[n][0])
        if (svTruthy(a)) return a
        return scriptEval(aux, code, env, code.kids[n][1])
    }
    if (k == snCond) {
        val c = scriptEval(aux, code, env, code.kids[n][0])
        return scriptEval(aux, code, env, code.kids[n][if (svTruthy(c)) 1 else 2])
    }
    if (k == snFunc) return SVal(svFn, n, "", [])
    if (k == snList) {
        val items: array<SVal> = []
        for (c in code.kids[n]) items.append(scriptEval(aux, code, env, c))
        return SVal(svList, 0, "", items)
    }
    svUndef()
}

fun HOST.scriptAssign(aux: AUX, code: ScriptCode, var env: ScriptEnv, target: int, value: SVal): void {
    val k = code.kind[target]
    if (k == snName) {
        val i = env.lookup(code.str[target])
        if (i >= 0) env.values[i] = svCopy(value)
        else hostThisSet(aux, code.str[target], value)
    } else if (k == snAttr) hostAttrSet(aux, code.str[target], value)
    else if (k == snMember) {
        val obj = code.kids[target][0]
        if (code.kind[obj] == snThis) hostThisSet(aux, code.str[target], value)
        else {
            val o = scriptEval(aux, code, env, obj)
            if (o.kind == svHost && o.s == "this") hostThisSet(aux, code.str[target], value)
            else hostMethodCall(aux, o, "=" + code.str[target], [value])
        }
    } else hostFail(aux, "can't assign")
    return
}

fun HOST.scriptExec(aux: AUX, code: ScriptCode, var env: ScriptEnv, n: int): void {
    if (env.returning) return
    val k = code.kind[n]
    if (k == snBlock) {
        for (c in code.kids[n]) scriptExec(aux, code, env, c)
    } else if (k == snVar) {
        val v = if (code.kids[n].size > 0) scriptEval(aux, code, env, code.kids[n][0]) else svUndef()
        env.names.append(code.str[n])
        env.values.append(v)
    } else if (k == snIf) {
        val c = scriptEval(aux, code, env, code.kids[n][0])
        if (svTruthy(c)) scriptExec(aux, code, env, code.kids[n][1])
        else if (code.kids[n].size > 2) scriptExec(aux, code, env, code.kids[n][2])
    } else if (k == snWhile) {
        var guard = 0
        while (!env.returning && guard < 1000000 && svTruthy(scriptEval(aux, code, env, code.kids[n][0]))) {
            scriptExec(aux, code, env, code.kids[n][1])
            guard += 1
        }
    } else if (k == snReturn) {
        env.result = if (code.kids[n].size > 0) scriptEval(aux, code, env, code.kids[n][0]) else svUndef()
        env.returning = true
    } else if (k == snExpr) {
        scriptEval(aux, code, env, code.kids[n][0])
    } else if (k == snAssign) {
        val target = code.kids[n][0]
        var v = scriptEval(aux, code, env, code.kids[n][1])
        if (code.num[n] != 0) {
            val old = scriptEval(aux, code, env, target)
            v = scriptBinary(aux, if (code.num[n] == 1) "+" else "-", old, v)
        }
        scriptAssign(aux, code, env, target, v)
    }
    return
}

// Runs statements in a fresh environment.
fun HOST.scriptRun(aux: AUX, code: ScriptCode, n: int): void {
    if (n < 0) return
    val env = scriptEnv()
    scriptExec(aux, code, env, n)
}

// Evaluates a predicate; one that didn't parse (n < 0) is true.
fun HOST.scriptTest(aux: AUX, code: ScriptCode, n: int): bool {
    if (n < 0) return true
    val env = scriptEnv()
    svTruthy(scriptEval(aux, code, env, n))
}

fun HOST.scriptValue(aux: AUX, code: ScriptCode, n: int): SVal {
    if (n < 0) return svUndef()
    val env = scriptEnv()
    scriptEval(aux, code, env, n)
}
