// The action language: grammar actions, semantic predicates and named
// actions are written in a small JavaScript-like language that the runtime
// interprets. Statements: var, if/else, while, return, blocks, assignments
// (=, +=, -=) and expressions. Expressions: numbers, strings, true, false,
// null, this, names, $attributes, member access, calls, function
// expressions, unary ! and -, arithmetic, comparisons (== != === !== < >
// <= >=), && || and ?:. What this, $x and the members of runtime values mean
// is up to the host (the parser or the lexer): script_eval.tmpl is the
// evaluator, generated for each host by tools/gen_script_eval.sh.

import "abla/text"

val svUndefined = 0
val svNull = 1
val svBool = 2
val svNum = 3
val svStr = 4
val svFn = 5
val svToken = 6
val svCtx = 7
val svHost = 8
val svList = 9

class SVal(val kind: int, val n: int, val s: string, val items: array<SVal>)

fun svUndef(): SVal = SVal(svUndefined, 0, "", [])
fun svNullValue(): SVal = SVal(svNull, 0, "", [])
fun svBoolean(b: bool): SVal = SVal(svBool, if (b) 1 else 0, "", [])
fun svNumber(n: int): SVal = SVal(svNum, n, "", [])
fun svString(s: string): SVal = SVal(svStr, 0, s, [])
fun svTokenRef(t: int): SVal = SVal(svToken, t, "", [])
fun svCtxRef(c: int): SVal = SVal(svCtx, c, "", [])
fun svHostObject(name: string, n: int): SVal = SVal(svHost, n, name, [])

fun svListOf(items: array<SVal>): SVal {
    val copy: array<SVal> = []
    for (i in items) copy.append(i)
    SVal(svList, 0, "", copy)
}

fun svCopy(v: SVal): SVal = SVal(v.kind, v.n, "" + v.s, copyValues(v.items))

fun copyValues(items: array<SVal>): array<SVal> {
    val r: array<SVal> = []
    for (i in items) r.append(svCopy(i))
    r
}


// node kinds
val snBlock = 1
val snVar = 2
val snIf = 3
val snWhile = 4
val snReturn = 5
val snExpr = 6
val snAssign = 7
val snEmpty = 8
val snNum = 20
val snStr = 21
val snBool = 22
val snNull = 23
val snUndefined = 24
val snThis = 25
val snName = 26
val snAttr = 27
val snMember = 28
val snCall = 29
val snIndex = 30
val snUnary = 31
val snBinary = 32
val snAnd = 33
val snOr = 34
val snCond = 35
val snFunc = 36
val snList = 37

class ScriptCode(
    var kind: array<int>,
    var num: array<int>,
    var str: array<string>,
    var kids: array<array<int>>,
    var errors: array<string>
) {
    fun node(k: int, n: int, s: string): int {
        kind.append(k)
        num.append(n)
        str.append(s)
        kids.append([])
        kind.size - 1
    }

    fun add(p: int, c: int): void {
        kids[p].append(c)
    }
}

fun scriptCode(): ScriptCode = ScriptCode([], [], [], [], [])

// tokens of action text
val stEnd = 0
val stName = 1
val stNum = 2
val stStr = 3
val stAttr = 4
val stPunct = 5

class ScriptLexer(var types: array<int>, var texts: array<string>, var nums: array<int>, var p: int)

fun isIdStart(c: int): bool = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
fun isIdPart(c: int): bool = isIdStart(c) || (c >= 48 && c <= 57)

fun scriptTokens(text: string): ScriptLexer {
    val lx = ScriptLexer([], [], [], 0)
    var i = 0
    val n = text.size
    while (i < n) {
        val c = text[i]
        if (c == 32 || c == 9 || c == 10 || c == 13 || c == 12) i += 1
        else if (c == 47 && i + 1 < n && text[i + 1] == 47) {
            while (i < n && text[i] != 10) i += 1
        } else if (c == 47 && i + 1 < n && text[i + 1] == 42) {
            val e = text.indexOf("*/", i + 2)
            i = if (e < 0) n else e + 2
        } else if (isIdStart(c)) {
            var j = i + 1
            while (j < n && isIdPart(text[j])) j += 1
            lx.types.append(stName)
            lx.texts.append(text.slice(i, j))
            lx.nums.append(0)
            i = j
        } else if (c == 36 && i + 1 < n && isIdStart(text[i + 1])) {
            var j = i + 2
            while (j < n && isIdPart(text[j])) j += 1
            lx.types.append(stAttr)
            lx.texts.append(text.slice(i + 1, j))
            lx.nums.append(0)
            i = j
        } else if (c >= 48 && c <= 57) {
            var j = i
            var v = 0
            while (j < n && text[j] >= 48 && text[j] <= 57) {
                v = v * 10 + (text[j] - 48)
                j += 1
            }
            lx.types.append(stNum)
            lx.texts.append(text.slice(i, j))
            lx.nums.append(v)
            i = j
        } else if (c == 34 || c == 39) {
            var j = i + 1
            var s = ""
            while (j < n && text[j] != c) {
                if (text[j] == 92 && j + 1 < n) {
                    val e = text[j + 1]
                    if (e == 110) s = s + "\n"
                    else if (e == 116) s = s + "\t"
                    else if (e == 114) s = s + "\r"
                    else if (e == 98) s = s + "\u{8}"
                    else if (e == 102) s = s + "\u{C}"
                    else if (e == 48) s = s + "\u{0}"
                    else if (e == 117 && j + 5 < n) {
                        var v = 0
                        var k = 2
                        while (k <= 5) {
                            v = v * 16 + hexDigitValue(text[j + k])
                            k += 1
                        }
                        s = s + utf8Encode(v)
                        j += 4
                    } else s = s + text.slice(j + 1, j + 2)
                    j += 2
                } else {
                    s = s + text.slice(j, j + 1)
                    j += 1
                }
            }
            lx.types.append(stStr)
            lx.texts.append(s)
            lx.nums.append(0)
            i = j + 1
        } else {
            var len = 1
            val three = if (i + 3 <= n) text.slice(i, i + 3) else ""
            val two = if (i + 2 <= n) text.slice(i, i + 2) else ""
            if (three == "===" || three == "!==") len = 3
            else if (two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||" || two == "+=" || two == "-=" || two == "++" || two == "--") len = 2
            lx.types.append(stPunct)
            lx.texts.append(text.slice(i, i + len))
            lx.nums.append(0)
            i += len
        }
    }
    lx.types.append(stEnd)
    lx.texts.append("")
    lx.nums.append(0)
    lx
}

fun hexDigitValue(c: int): int =
    if (c >= 48 && c <= 57) c - 48 else if (c >= 97 && c <= 102) c - 87 else if (c >= 65 && c <= 70) c - 55 else 0

class ScriptParser(val lx: ScriptLexer, var p: int, var error: string)

fun ScriptParser.peekType(): int = lx.types[p]
fun ScriptParser.peekText(): string = lx.texts[p]
fun ScriptParser.isPunct(s: string): bool = lx.types[p] == stPunct && lx.texts[p] == s
fun ScriptParser.isWord(s: string): bool = lx.types[p] == stName && lx.texts[p] == s

fun ScriptParser.fail(what: string): void {
    if (error.size == 0) error = "expected $what at '${lx.texts[p]}'"
}

fun ScriptParser.expectPunct(s: string): void {
    if (isPunct(s)) p += 1 else fail("'$s'")
}

fun ScriptParser.statement(var code: ScriptCode): int {
    if (error.size > 0) return code.node(snEmpty, 0, "")
    if (isPunct("{")) {
        p += 1
        val b = code.node(snBlock, 0, "")
        while (error.size == 0 && !isPunct("}") && peekType() != stEnd) code.add(b, statement(code))
        expectPunct("}")
        return b
    }
    if (isPunct(";")) {
        p += 1
        return code.node(snEmpty, 0, "")
    }
    if (isWord("var") || isWord("let") || isWord("const")) {
        p += 1
        val name = peekText()
        if (peekType() != stName) fail("a name")
        p += 1
        val v = code.node(snVar, 0, name)
        if (isPunct("=")) {
            p += 1
            code.add(v, expression(code))
        }
        if (isPunct(";")) p += 1
        return v
    }
    if (isWord("if")) {
        p += 1
        expectPunct("(")
        val cond = expression(code)
        expectPunct(")")
        val thenPart = statement(code)
        val n = code.node(snIf, 0, "")
        code.add(n, cond)
        code.add(n, thenPart)
        if (isWord("else")) {
            p += 1
            code.add(n, statement(code))
        }
        return n
    }
    if (isWord("while")) {
        p += 1
        expectPunct("(")
        val cond = expression(code)
        expectPunct(")")
        val body = statement(code)
        val n = code.node(snWhile, 0, "")
        code.add(n, cond)
        code.add(n, body)
        return n
    }
    if (isWord("return")) {
        p += 1
        val n = code.node(snReturn, 0, "")
        if (!isPunct(";") && !isPunct("}") && peekType() != stEnd) code.add(n, expression(code))
        if (isPunct(";")) p += 1
        return n
    }
    val e = expression(code)
    var result = 0
    if (isPunct("=") || isPunct("+=") || isPunct("-=")) {
        val op = if (isPunct("=")) 0 else if (isPunct("+=")) 1 else 2
        p += 1
        val value = expression(code)
        result = code.node(snAssign, op, "")
        code.add(result, e)
        code.add(result, value)
    } else if (isPunct("++") || isPunct("--")) {
        val op = if (isPunct("++")) 1 else 2
        p += 1
        result = code.node(snAssign, op, "")
        code.add(result, e)
        code.add(result, code.node(snNum, 1, ""))
    } else {
        result = code.node(snExpr, 0, "")
        code.add(result, e)
    }
    if (isPunct(";")) p += 1
    result
}

fun ScriptParser.expression(var code: ScriptCode): int {
    val c = orExpr(code)
    if (isPunct("?")) {
        p += 1
        val a = expression(code)
        expectPunct(":")
        val b = expression(code)
        val n = code.node(snCond, 0, "")
        code.add(n, c)
        code.add(n, a)
        code.add(n, b)
        return n
    }
    c
}

fun ScriptParser.orExpr(var code: ScriptCode): int {
    var l = andExpr(code)
    while (error.size == 0 && isPunct("||")) {
        p += 1
        val r = andExpr(code)
        val n = code.node(snOr, 0, "")
        code.add(n, l)
        code.add(n, r)
        l = n
    }
    l
}

fun ScriptParser.andExpr(var code: ScriptCode): int {
    var l = binary(code, 0)
    while (error.size == 0 && isPunct("&&")) {
        p += 1
        val r = binary(code, 0)
        val n = code.node(snAnd, 0, "")
        code.add(n, l)
        code.add(n, r)
        l = n
    }
    l
}

fun operatorLevel(s: string): int =
    if (s == "==" || s == "!=" || s == "===" || s == "!==") 0
    else if (s == "<" || s == ">" || s == "<=" || s == ">=") 1
    else if (s == "+" || s == "-") 2
    else if (s == "*" || s == "/" || s == "%") 3
    else -1

fun ScriptParser.binary(var code: ScriptCode, level: int): int {
    if (level > 3) return unary(code)
    var l = binary(code, level + 1)
    while (error.size == 0 && peekType() == stPunct && operatorLevel(peekText()) == level) {
        val op = peekText()
        p += 1
        val r = binary(code, level + 1)
        val n = code.node(snBinary, 0, op)
        code.add(n, l)
        code.add(n, r)
        l = n
    }
    l
}

fun ScriptParser.unary(var code: ScriptCode): int {
    if (isPunct("!") || isPunct("-")) {
        val op = peekText()
        p += 1
        val e = unary(code)
        val n = code.node(snUnary, 0, op)
        code.add(n, e)
        return n
    }
    postfix(code)
}

fun ScriptParser.arguments(var code: ScriptCode, call: int): void {
    expectPunct("(")
    if (!isPunct(")")) {
        code.add(call, expression(code))
        while (error.size == 0 && isPunct(",")) {
            p += 1
            code.add(call, expression(code))
        }
    }
    expectPunct(")")
}

fun ScriptParser.postfix(var code: ScriptCode): int {
    var e = primary(code)
    var going = true
    while (going && error.size == 0) {
        if (isPunct(".")) {
            p += 1
            val name = peekText()
            if (peekType() != stName) fail("a member name")
            p += 1
            val m = code.node(snMember, 0, name)
            code.add(m, e)
            e = m
        } else if (isPunct("(")) {
            val c = code.node(snCall, 0, "")
            code.add(c, e)
            arguments(code, c)
            e = c
        } else if (isPunct("[")) {
            p += 1
            val idx = expression(code)
            expectPunct("]")
            val n = code.node(snIndex, 0, "")
            code.add(n, e)
            code.add(n, idx)
            e = n
        } else going = false
    }
    e
}

fun ScriptParser.primary(var code: ScriptCode): int {
    val t = peekType()
    val txt = peekText()
    if (t == stNum) {
        p += 1
        return code.node(snNum, lx.nums[p - 1], "")
    }
    if (t == stStr) {
        p += 1
        return code.node(snStr, 0, txt)
    }
    if (t == stAttr) {
        p += 1
        return code.node(snAttr, 0, txt)
    }
    if (t == stName) {
        p += 1
        if (txt == "true") return code.node(snBool, 1, "")
        if (txt == "false") return code.node(snBool, 0, "")
        if (txt == "null") return code.node(snNull, 0, "")
        if (txt == "undefined") return code.node(snUndefined, 0, "")
        if (txt == "this") return code.node(snThis, 0, "")
        if (txt == "function") {
            val params: array<string> = []
            expectPunct("(")
            while (error.size == 0 && !isPunct(")")) {
                params.append(peekText())
                p += 1
                if (isPunct(",")) p += 1
            }
            expectPunct(")")
            val f = code.node(snFunc, 0, textJoin(params, ","))
            code.add(f, statement(code))
            return f
        }
        if (txt == "new") {
            // new X(...): a call of X
            return postfix(code)
        }
        return code.node(snName, 0, txt)
    }
    if (isPunct("(")) {
        p += 1
        val e = expression(code)
        expectPunct(")")
        return e
    }
    if (isPunct("[")) {
        p += 1
        val n = code.node(snList, 0, "")
        while (error.size == 0 && !isPunct("]")) {
            code.add(n, expression(code))
            if (isPunct(",")) p += 1
        }
        expectPunct("]")
        return n
    }
    fail("an expression")
    p += 1
    code.node(snUndefined, 0, "")
}

// Parses statements; returns the block node (empty with an error recorded).
fun ScriptCode.parseStatements(text: string): int {
    val ps = ScriptParser(scriptTokens(text), 0, "")
    val b = node(snBlock, 0, "")
    while (ps.error.size == 0 && ps.peekType() != stEnd) add(b, ps.statement(this))
    if (ps.error.size > 0) {
        errors.append("${ps.error} in {$text}")
        kids[b].clear()
    }
    b
}

// Parses one expression; returns -1 when it doesn't parse.
fun ScriptCode.parseExpression(text: string): int {
    val ps = ScriptParser(scriptTokens(text), 0, "")
    val e = ps.expression(this)
    if (ps.error.size == 0 && ps.peekType() != stEnd) ps.fail("the end")
    if (ps.error.size > 0) {
        errors.append("${ps.error} in {$text}")
        return -1
    }
    e
}

// Parses comma-separated expressions into a list node.
fun ScriptCode.parseList(text: string): int {
    val ps = ScriptParser(scriptTokens(text), 0, "")
    val n = node(snList, 0, "")
    while (ps.error.size == 0 && ps.peekType() != stEnd) {
        add(n, ps.expression(this))
        if (ps.isPunct(",")) ps.p += 1
        else if (ps.peekType() != stEnd) ps.fail("','")
    }
    if (ps.error.size > 0) {
        errors.append("${ps.error} in [$text]")
        kids[n].clear()
    }
    n
}

// evaluation state and value rules shared by the hosts

class ScriptEnv(var names: array<string>, var values: array<SVal>, var returning: bool, var result: SVal)

fun scriptEnv(): ScriptEnv = ScriptEnv([], [], false, svUndef())

fun ScriptEnv.lookup(name: string): int {
    var i = names.size - 1
    var found = -1
    while (found < 0 && i >= 0) {
        if (names[i] == name) found = i
        i -= 1
    }
    found
}

fun svTruthy(v: SVal): bool {
    val k = v.kind
    if (k == svUndefined || k == svNull) return false
    if (k == svBool || k == svNum) return v.n != 0
    if (k == svStr) return v.s.size > 0
    true
}

fun svStrictEquals(a: SVal, b: SVal): bool {
    if (a.kind != b.kind) return false
    if (a.kind == svStr) return a.s == b.s
    if (a.kind == svHost) return a.s == b.s && a.n == b.n
    if (a.kind == svList) return false
    a.n == b.n
}

fun svLooseEquals(a: SVal, b: SVal): bool {
    val an = a.kind == svNull || a.kind == svUndefined
    val bn = b.kind == svNull || b.kind == svUndefined
    if (an || bn) return an && bn
    if ((a.kind == svNum || a.kind == svBool) && (b.kind == svNum || b.kind == svBool)) return a.n == b.n
    if (a.kind == svStr && b.kind == svNum) return a.s == "${b.n}"
    if (a.kind == svNum && b.kind == svStr) return b.s == "${a.n}"
    svStrictEquals(a, b)
}

fun svNumberOf(v: SVal): int {
    if (v.kind == svNum || v.kind == svBool) return v.n
    if (v.kind == svStr) {
        var n = 0
        var neg = false
        var i = 0
        if (v.s.size > 0 && v.s[0] == 45) {
            neg = true
            i = 1
        }
        while (i < v.s.size && v.s[i] >= 48 && v.s[i] <= 57) {
            n = n * 10 + (v.s[i] - 48)
            i += 1
        }
        return if (neg) -n else n
    }
    0
}

// The action code of a grammar and where it runs, keyed by ATN state for the
// parser (actions, rule invocations with arguments, labels) and by index for
// lexer actions and predicates.
class ScriptTables(
    var code: ScriptCode,
    var enabled: bool,
    var members: int,
    var lexerActions: array<int>,
    var predicates: array<int>,
    var predicateTexts: array<string>,
    var predicateFails: array<int>,
    var actionAt: Map<int, int>,
    var ruleInit: array<int>,
    var ruleAfter: array<int>,
    var ruleArgs: array<array<string>>,
    var ruleReturns: array<array<string>>,
    var ruleReturnInits: array<array<int>>,
    var ruleLocals: array<array<string>>,
    var ruleLocalInits: array<array<int>>,
    var callArgs: Map<int, int>,
    var labels: Map<int, string>,
    var listLabels: Map<int, bool>,
    var elementNames: Map<int, string>,
    var tokenTypes: Map<string, int>,
    var altLabels: array<array<string>>
)

fun scriptTables(): ScriptTables = ScriptTables(scriptCode(), false, -1, [], [], [], [], Map(), [], [], [], [], [], [], [], Map(), Map(), Map(), Map(), Map(), [])

// The text of {...} or {...}? without its delimiters.
fun actionBody(text: string): string {
    var a = 0
    var b = text.size
    if (b > 0 && text[0] == 123) a = 1
    if (b >= 2 && text[b - 2] == 125 && text[b - 1] == 63) b -= 2
    else if (b > a && text[b - 1] == 125) b -= 1
    if (b < a) b = a
    text.slice(a, b)
}

// Rule argument, return and local declarations ("int x, String s = null"):
// the names and the initializers (-1 for none), as ScopeParser reads them.
class ScriptDecls(var names: array<string>, var inits: array<int>)

fun ScriptCode.parseDecls(text: string): ScriptDecls {
    val d = ScriptDecls([], [])
    val parts: array<string> = []
    var depth = 0
    var from = 0
    for (i in 0 until text.size) {
        val c = text[i]
        if (c == 60 || c == 40 || c == 91 || c == 123) depth += 1
        else if (c == 62 || c == 41 || c == 93 || c == 125) depth -= 1
        else if (c == 44 && depth == 0) {
            parts.append(text.slice(from, i))
            from = i + 1
        }
    }
    parts.append(text.slice(from, text.size))
    for (part in parts) {
        val eq = part.indexOf("=")
        val decl = if (eq >= 0) part.slice(0, eq) else part
        var e = decl.size
        while (e > 0 && !isIdPart(decl[e - 1])) e -= 1
        var s = e
        while (s > 0 && isIdPart(decl[s - 1])) s -= 1
        if (e > s) {
            d.names.append(decl.slice(s, e))
            d.inits.append(if (eq >= 0) parseExpression(part.slice(eq + 1, part.size)) else -1)
        }
    }
    d
}
