// An ANTLR 4 runtime for Abla, in interpreter mode: grammars load from .g4
// files (compiled as the ANTLR 4.9 tool does) or from the .interp files the
// tool writes, and parse exactly as the antlr4 4.9 JavaScript runtime with the
// tool's generated parser does (tokens, trees, syntax error messages and
// recovery).

import "atn.ab"
import "context.ab"
import "configs.ab"
import "lexer.ab"
import "grammar.ab"
import "engine.ab"
import "interpret.ab"
import "g4.ab"

val nodeRule = 0
val nodeToken = 1
val nodeError = 2

class AntlrToken(
    val type: int,
    val text: string,
    val line: int,
    val column: int,
    val channel: int,
    val tokenIndex: int,
    val start: int,
    val stop: int
)

// A parse tree node: a rule context (ruleIndex, alt, children) or a token
// (token; nodeError for tokens matched or conjured during error recovery).
class AntlrNode(
    val kind: int,
    val ruleIndex: int,
    val alt: int,
    val token: AntlrToken?,
    val children: array<AntlrNode>,
    val startToken: int,
    val stopToken: int
)

class AntlrError(val line: int, val column: int, val message: string)

class AntlrResult(
    val tree: AntlrNode,
    val tokens: array<AntlrToken>,
    val errors: array<AntlrError>,
    val lexerErrors: array<AntlrError>,
    val messages: array<AntlrError>
)

// A loaded grammar pair; error is empty when loading succeeded. codePoints
// makes the input a sequence of code points (positions count code points,
// as antlr4's InputStream with decodeToUnicodeCodePoints) instead of UTF-16
// code units.
class Antlr(
    val lexerAtn: Atn,
    val parser: ParserGrammar,
    var engine: Engine,
    val error: string,
    var codePoints: bool
)

fun antlrLoad(lexerInterp: string, parserInterp: string): Antlr {
    val lexerAtn = deserializeAtn(parseInterp(lexerInterp).atnValues)
    val grammar = compileParserGrammar(parserInterp)
    var error = ""
    if (lexerAtn.error.size > 0) error = "lexer: ${lexerAtn.error}"
    else if (lexerAtn.grammarType != atnLexer) error = "lexer: not a lexer ATN"
    else if (grammar.error.size > 0) error = "parser: ${grammar.error}"
    val lexerDfas: array<Dfa> = []
    for (m in 0 until lexerAtn.modeToStart.size) lexerDfas.append(dfaFor(lexerAtn.modeToStart[m], m, false))
    val lexer = Lexer(contextPool(), configPool(), executorPool(), lexerDfas,
        sourceText(""), 0, 1, 0, -1, 0, [], -1, 0, -1, -1, false, 0, 0, -1, -1, -1, false, tokens(), [])
    val parserDfas: array<Dfa> = []
    val atn = grammar.atn
    for (d in 0 until atn.decisionToState.size) {
        val s = atn.decisionToState[d]
        parserDfas.append(dfaFor(s, d, atn.stateType[s] == stStarLoopEntry && atn.precedenceDecision[s]))
    }
    Antlr(lexerAtn, grammar, engine(lexer, lexerAtn, parserDfas), error, false)
}

// Compiles .g4 grammars and loads them. sources maps file names ("Expr.g4")
// to their text, imported grammars and token vocabularies included. For a
// combined grammar, lexerGrammar and parserGrammar are the same name.
fun antlrLoadGrammars(sources: Map<string, string>, lexerGrammar: string, parserGrammar: string): Antlr {
    val lexerOut = g4Compile(sources, lexerGrammar)
    var lexerInterp = lexerOut.lexerInterp
    var parserInterp = lexerOut.parserInterp
    var error = lexerOut.error
    if (error.size == 0 && parserGrammar != lexerGrammar) {
        val parserOut = g4Compile(sources, parserGrammar)
        parserInterp = parserOut.parserInterp
        error = parserOut.error
    }
    if (error.size == 0 && lexerInterp.size == 0) error = "$lexerGrammar has no lexer rules"
    if (error.size == 0 && parserInterp.size == 0) error = "$parserGrammar has no parser rules"
    if (error.size > 0) return antlrFailed(error)
    antlrLoad(lexerInterp, parserInterp)
}

fun antlrFailed(error: string): Antlr {
    val a = antlrLoad("", "")
    Antlr(a.lexerAtn, a.parser, a.engine, error, false)
}

fun Antlr.ruleNames(): array<string> = parser.ruleNames

fun Antlr.resetLexer(source: string): void {
    engine.lexer.input = if (codePoints) codePointText(source) else sourceText(source)
    engine.lexer.index = 0
    engine.lexer.line = 1
    engine.lexer.column = 0
    engine.lexer.startIndex = -1
    engine.lexer.mode = 0
    engine.lexer.modeStack.clear()
    engine.lexer.hitEof = false
    engine.lexer.out = tokens()
    engine.lexer.errors = []
}

fun Antlr.lex(source: string): void {
    resetLexer(source)
    engine.lexer.tokenizeAll(lexerAtn)
}

fun Antlr.resetEngine(): void {
    engine.tokens = tokens()
    engine.streamCount = 0
    engine.fetchedEof = false
    engine.missing = tokens()
    engine.messages = []
    engine.lexerErrorCount = 0
    engine.ctxRule.clear()
    engine.ctxParent.clear()
    engine.ctxInvoking.clear()
    engine.ctxStart.clear()
    engine.ctxStop.clear()
    engine.ctxAlt.clear()
    engine.ctxChildren.clear()
    engine.cur = -1
    engine.state = -1
    engine.precStack.clear()
    engine.precStack.append(0)
    engine.recovering = false
    engine.lastErrorIndex = -1
    engine.lastErrorStates.clear()
    engine.hasLastErrorStates = false
    engine.exc = excNone
    engine.errors = []
    engine.frameParent.clear()
    engine.frameParentState.clear()
    engine.frameStart.clear()
    engine.seek(0)
}

fun Engine.buildToken(t: int): AntlrToken =
    AntlrToken(tokType(t), tokText(t), tokLine(t), tokColumn(t), tokChannel(t), tokIndex(t), tokStart(t), tokStop(t))

fun Engine.buildNode(ctx: int): AntlrNode {
    val children: array<AntlrNode> = []
    for (child in ctxChildren[ctx]) {
        if (child >= 0) children.append(buildNode(child))
        else {
            val code = -1 - child
            val t = code / 2
            children.append(AntlrNode(if (code % 2 == 1) nodeError else nodeToken, -1, 0, buildToken(t), [], t, t))
        }
    }
    AntlrNode(nodeRule, ctxRule[ctx], ctxAlt[ctx], null, children, ctxStart[ctx], ctxStop[ctx])
}

fun antlrErrorList(errors: array<SyntaxErr>): array<AntlrError> {
    val result: array<AntlrError> = []
    for (e in errors) result.append(AntlrError(e.line, e.column, e.message))
    result
}

// Parses source from the named start rule.
// The tokens are read from the lexer as the parser needs them; after the parse
// the rest of the input is lexed too, so tokens and lexerErrors cover it all,
// while messages holds the errors in the order a generated parser reports
// them (lexer errors as tokens were fetched, then parser errors).
fun Antlr.parse(source: string, startRule: string): AntlrResult {
    resetLexer(source)
    resetEngine()
    val rule = parser.ruleIndex(startRule)
    val root = if (rule >= 0) engine.invokeRule(parser, rule, 0) else engine.newContext(0, -1, -1)
    val messages = antlrErrorList(engine.messages)
    engine.fill()
    val tokenList: array<AntlrToken> = []
    for (t in 0 until engine.streamCount) tokenList.append(engine.buildToken(t))
    val lexErrors: array<AntlrError> = []
    for (e in engine.lexer.errors) lexErrors.append(AntlrError(e.line, e.column, e.message))
    AntlrResult(engine.buildNode(root), tokenList, antlrErrorList(engine.errors), lexErrors, messages)
}

fun escapeWhitespace(s: string): string = s.replace("\t", "\\t").replace("\n", "\\n").replace("\r", "\\r")

// Trees.toStringTree(tree, ruleNames)
fun antlrTreeText(node: AntlrNode, ruleNames: array<string>): string {
    var text = ""
    val token = node.token
    if (node.kind == nodeRule) text = escapeWhitespace(ruleNames[node.ruleIndex])
    else if (token != null) text = escapeWhitespace(token.text)
    if (node.children.size > 0) {
        var s = "($text"
        for (child in node.children) s = s + " " + antlrTreeText(child, ruleNames)
        text = s + ")"
    }
    text
}
